; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Zen Mahjong Journey"
config/description="A calm, Android-first Mahjong Solitaire journey."
config/version="0.1.0"
run/main_scene="res://scenes/screens/startup_screen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.20784314, 0.30980393, 0.26666668, 1)
boot_splash/show_image=false
config/icon="res://assets/branding/app_icon_preview_512.png"
config/quit_on_go_back=false

[autoload]

GameSession="*res://scripts/autoload/game_session.gd"
TileCollectionManager="*res://scripts/autoload/tile_collection_manager.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

theme/custom="res://themes/zen_theme.tres"

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
environment/defaults/default_clear_color=Color(0.20784314, 0.30980393, 0.26666668, 1)

[zen_mahjong]

tiles/art_set="res://data/tile_art/classic_v1.json"
