[ext_resource type="Texture2D" path="res://assets/ui/icons/icon_next.png" id="5_next"]

[node name="DailyScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
